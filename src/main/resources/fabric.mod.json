{
	"schemaVersion": 1,
	"id": "tgbridge",
	"version": "${version}",
	"name": "Telegram Bridge Client",
	"description": "Client-side mod for Telegram Bridge: in-chat photo previews, fullscreen image viewer, clipboard pasting, and voice messages.",
	"authors": [
		"Durhol",
		"vanutp"
	],
	"contact": {
		"homepage": "https://github.com/Durhol/tgbridge-client",
		"sources": "https://github.com/Durhol/tgbridge-client",
		"issues": "https://github.com/Durhol/tgbridge-client/issues"
	},
	"license": "MIT",
	"icon": "assets/tgbridge/icon.png",
	"environment": "client",
	"accessWidener": "tgbridge.accesswidener",
	"entrypoints": {
		"client": [
			{
				"value": "dev.vanutp.tgbridge.fabric.FabricTelegramBridgeClient",
				"adapter": "kotlin"
			}
		],
		"voicechat": [
			"dev.vanutp.tgbridge.common.modules.VoiceChatPlugin"
		]
	},
	"mixins": [
		"tgbridge.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.2",
		"minecraft": ">=1.21 <=1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=1.9.0"
	},
	"suggests": {
		"voicechat": "*"
	}
}
